        ms1_0.trainer_username,
        ms1_0.updated_at,
        ms1_0.`year` 
    from
        monthly_summaries ms1_0 
    left join
        trainers t1_0 
            on t1_0.username=ms1_0.trainer_username 
    where
        t1_0.username=?
